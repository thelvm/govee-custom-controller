; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=2

[application]

config/name="Govee Custom Controller"
config/version="0.2"
run/main_scene="uid://mrkqbib1mkok"
config/use_custom_user_dir=true
config/custom_user_dir_name="Govee Custom Controller"
config/features=PackedStringArray("4.8", "GL Compatibility")
run/low_processor_mode=true
run/delta_smoothing=false
config/icon="res://icon.svg"

[display]

window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/multi_bounce_occlusion/enabled=true
